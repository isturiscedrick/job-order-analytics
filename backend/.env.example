# Server-side upstream endpoint. Copy this file to backend/.env.
JOB_ORDERS_API_URL=https://cmiitdept.com/mmp/api_get_job_master
EXTERNAL_API_TIMEOUT_SECONDS=20

# Seconds a successful upstream response is reused before calling CMIIT again. 0 disables caching.
JOB_ORDERS_CACHE_TTL_SECONDS=60

# Comma-separated origins allowed to call this API from a browser (no trailing slash).
# Leave empty for local dev, or when the frontend and API are served from the same origin.
# Example: CORS_ALLOWED_ORIGINS=https://analytics.example.com
CORS_ALLOWED_ORIGINS=